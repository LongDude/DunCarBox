[Unit]
Description=Dynamic IPv6 prefix and Cloudflare DDNS synchronizer
After=NetworkManager.service network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple

ExecStart=/usr/local/sbin/ipv6-prefix-ddns \
    /etc/ipv6-prefix-ddns/config.conf

Restart=on-failure
RestartSec=10

User=root
Group=root

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

ReadWritePaths=/var/lib/ipv6-prefix-ddns

[Install]
WantedBy=multi-user.target