# Optional settings for docker compose. Defaults work without an .env file.
DUNCARBOX_BACKEND_PORT=8000
DUNCARBOX_FRONTEND_PORT=8080
DUNCARBOX_POSTGRES_PORT=5432
DUNCARBOX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development/demo credentials only. POSTGRES_* initialize a new database volume.
# Changing them does not change credentials in an existing PostgreSQL volume.
POSTGRES_USER=duncarbox
POSTGRES_PASSWORD=duncarbox
POSTGRES_DB=duncarbox

# Local backend overrides may be exported in the shell when needed.
# DUNCARBOX_DATABASE_URL=postgresql://duncarbox:duncarbox@127.0.0.1:5432/duncarbox
# DUNCARBOX_TEST_DATABASE_URL=postgresql://duncarbox:duncarbox@127.0.0.1:5432/duncarbox
# DUNCARBOX_DEMO_DIR=../demo
# To avoid encoding passwords in a local URI, export these shell variables:
# DUNCARBOX_DATABASE_URL=postgresql://127.0.0.1:5432
# PGUSER=duncarbox
# PGPASSWORD=duncarbox
# PGDATABASE=duncarbox
# Compose passes POSTGRES_* as PGUSER/PGPASSWORD/PGDATABASE and uses the URI
# postgresql://db:5432, so the password never needs URI interpolation.
# Use single quotes around .env values containing a literal $ to avoid interpolation.
